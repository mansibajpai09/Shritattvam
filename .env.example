# ShriTattvam Environment Configuration
VITE_APP_TITLE=ShriTattvam

# Supabase Configuration
# 1. Open your project in Supabase Dashboard (https://supabase.com/dashboard)
# 2. Go to Project Settings -> API
# 3. Copy "Project URL" and paste into VITE_SUPABASE_URL
# 4. Copy "anon" / "public" key and paste into VITE_SUPABASE_ANON_KEY
# CRITICAL SECURITY NOTE: NEVER use or expose the "service_role" secret key in client-side code!
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
